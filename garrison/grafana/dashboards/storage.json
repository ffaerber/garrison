      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value #A": "Size",
              "Value #B": "Used",
              "Value #C": "Free",
              "Value #D": "Fragmentation"
            },
            "indexByName": {
              "machine": 0,
              "pool": 1,
              "Size": 2,
              "Used": 3,
              "Free": 4,
              "Fragmentation": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
