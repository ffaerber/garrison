# This computer's settings for the test runs (test/vm/steps.sh). Copy it to
# .env, which git ignores, and fill it in: addresses on your network and keys
# never go into the repo. Every setting may also come from the environment.

# The AI providers the setup adds after the install: name=url, separated by
# spaces; each an OpenAI-compatible API. GATEWAY in a URL is this computer as
# a test VM reaches it. Without PROVIDERS: Ollama on this computer,
# local=http://GATEWAY:11434/v1, with LOCAL_MODEL (default qwen3.8-64k:latest).
# Claude: Anthropic's OpenAI-compatible API, https://api.anthropic.com/v1.
PROVIDERS="gpu-box=http://10.0.0.5:11435/v1 ollama-cloud=https://ollama.com/v1 claude=https://api.anthropic.com/v1"
# A provider's key: <NAME>_API_KEY, upper case, - as _. One without a key (a
# server on your network) needs none.
OLLAMA_CLOUD_API_KEY=
CLAUDE_API_KEY=
# The default model, for every agent: <provider>/<model> of PROVIDERS.
DEFAULT_MODEL=gpu-box/qwen3.8-27b
# Agents on a model of their own, chosen on the Models page: agent=provider/model.
AGENT_MODELS="coder=ollama-cloud/glm-5.3"

# Services outside Garrison, as the test VMs reach them. Without them: the
# ones on this computer if they answer (ComfyUI with a GPU on 8188, a
# text-to-speech service on 8880), else a fake ComfyUI and no animalfacts.
COMFYUI_URL=http://10.0.0.6:8188
TTS_URL=http://10.0.0.6:8880
