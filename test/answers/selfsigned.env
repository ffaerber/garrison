# Answers for a headless test install. Sourced by install.sh.
DOMAIN=garrison.test
TLS_MODE=selfsigned
ADMIN_USER=admin
ADMIN_EMAIL=admin@garrison.test
POOL_SIZE=10G
# Google's public Docker Hub mirror: test runs pull every image again and
# would hit Docker Hub's limit on anonymous pulls.
REGISTRY_MIRROR=https://mirror.gcr.io
